generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id            String               @id @default(cuid())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  name          String
  birthDate     DateTime
  sex           Sex
  diagnosis     Diagnosis
  etiology      String?
  ckdStage      CkdStage?
  albuminuria   AlbuminuriaCategory?
  comorbidities String[]
  medications   String[]
  evolutions    Evolution[]
  labResults    LabResult[]

  @@index([name])
}

model Evolution {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  consultationDate  DateTime
  patientId         String
  chiefComplaint    String?
  bloodPressure     String?
  weight            Float?
  edema             String?
  clinicalNote      String?
  conductText       String?
  generatedExames   String?
  generatedEvolucao String?
  generatedConduta  String?
  imagingResults    String?
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, consultationDate])
}

model LabResult {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  examDate  DateTime
  patientId String
  examType  String
  unit      String?
  value     Float
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, examType, examDate])
}

enum Sex {
  MALE
  FEMALE
}

enum CkdStage {
  G1
  G2
  G3a
  G3b
  G4
  G5
  G5D
}

enum AlbuminuriaCategory {
  A1
  A2
  A3
}

enum Diagnosis {
  DRC
  HAS_NEFROSCLEROSE
  NEFROPATIA_DIABETICA
  GLOMERULOPATIA
  NEFROLITIASE
  CONSULTA_GERAL
}

model TextMacro {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  key       String   @unique  // ex: ".ret"
  value     String            // texto expandido
  category  String            // "complaint" | "clinicalNote" | "conductText" | "meds"
  position  Int      @default(0) // ordem dentro da categoria
}
