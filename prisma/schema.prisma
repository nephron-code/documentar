generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id            String               @id @default(cuid())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  name          String
  birthDate     DateTime
  sex           Sex
  diagnosis     Diagnosis
  etiology      String?
  ckdStage      CkdStage?
  albuminuria   AlbuminuriaCategory?
  comorbidities String[]
  height        Float?
  evolutions    Evolution[]
  labResults    LabResult[]
  medications   PatientMedication[]

  @@index([name])
}

model Evolution {
  id                    String              @id @default(cuid())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  consultationDate      DateTime
  patientId             String
  chiefComplaint        String?
  bloodPressure         String?
  weight                Float?
  edema                 String?
  heartRate             Int?
  nextConsultationDate  DateTime?
  orderedExams          String?
  clinicalNote          String?
  conductText           String?
  imagingResults        String?
  patient               Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescribedMedications PatientMedication[] @relation("PrescribedIn")
  suspendedMedications  PatientMedication[] @relation("SuspendedIn")

  @@index([patientId, consultationDate])
}

model PatientMedication {
  id              String    @id @default(cuid())
  createdAt       DateTime  @default(now())
  patientId       String
  name            String
  dose            String?
  frequency       String?
  notes           String?
  status          String    @default("ACTIVE") // "ACTIVE" | "DISCONTINUED"
  prescribedAt    DateTime  @default(now())
  suspendedAt     DateTime?
  prescribedInId  String?
  suspendedInId   String?
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  prescribedIn    Evolution? @relation("PrescribedIn", fields: [prescribedInId], references: [id])
  suspendedIn     Evolution? @relation("SuspendedIn", fields: [suspendedInId], references: [id])

  @@index([patientId, status])
}

model LabResult {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  examDate  DateTime
  patientId String
  examType  String
  unit      String?
  value     Float
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, examType, examDate])
}

enum Sex {
  MALE
  FEMALE
}

enum CkdStage {
  G1
  G2
  G3a
  G3b
  G4
  G5
  G5D
}

enum AlbuminuriaCategory {
  A1
  A2
  A3
}

enum Diagnosis {
  DRC
  HAS_NEFROSCLEROSE
  NEFROPATIA_DIABETICA
  GLOMERULOPATIA
  NEFROLITIASE
  CONSULTA_GERAL
}

model TextMacro {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  key       String   @unique  // ex: ".ret"
  value     String            // texto expandido
  category  String            // "complaint" | "clinicalNote" | "conductText" | "meds"
  position  Int      @default(0) // ordem dentro da categoria
}
